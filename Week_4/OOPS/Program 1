interface Test{
  void square();
}

class Arithmetic implements Test{
  int n;
  Arithmetic(int n){
    this.n=n;
  }
  public void square(){
    System.out.println("The Square of the number is: " + (n*n));
  }
}

public class ToTestInt {
    public static void main(String[] args) {
        Arithmetic arithmetic = new Arithmetic(5);
        arithmetic.square();
    }
}
